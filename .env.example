# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Voice ─────────────────────────────────────────────────────────────────────
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Cache ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
ACTIVE_PACK=dental_saas

# ── Vapi auth ─────────────────────────────────────────────────────────────────
# Set in Vapi assistant config; the backend rejects requests without the match.
# When set, the adversarial simulator also reads VAPI_LLM_SECRET and attaches
# a matching Bearer header — production-parity testing works automatically.
# In development these may be empty (auth disabled). In production the app
# REFUSES TO BOOT with empty secrets unless you explicitly set
# ALLOW_INSECURE_PUBLIC_ENDPOINTS=true.
VAPI_LLM_SECRET=
VAPI_SERVER_SECRET=
# ALLOW_INSECURE_PUBLIC_ENDPOINTS=false

# ── Calendar integration ─────────────────────────────────────────────────────
# Each pack picks its provider in pack.yaml (calendar.provider: cal_com | google
# | none). The credential for that provider lives here. Leave a provider's
# secret empty and its packs degrade to DB-only (row saved, no invite sent).
#
# Cal.com: one API key; the pack names which event_type_id to book.
CALCOM_API_KEY=
# CALCOM_BASE_URL=https://api.cal.com/v1
#
# Google Calendar: service-account credentials, either the raw JSON blob or a
# path to the file. Share the target calendar with the service account (and use
# domain-wide delegation if you need attendee invites). Pack names calendar_id.
GOOGLE_CALENDAR_CREDENTIALS_JSON=

# ── Hardening knobs (defaults shown) ─────────────────────────────────────────
# MAX_REQUEST_BYTES=1000000
# GENERATION_TIMEOUT_SECONDS=30
# CLASSIFIER_TIMEOUT_SECONDS=10
