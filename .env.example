# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Voice ─────────────────────────────────────────────────────────────────────
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Cache ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
ACTIVE_PACK=dental_saas

# ── Vapi auth (optional; leave empty to disable) ─────────────────────────────
# Set in Vapi assistant config; the backend rejects requests without the match.
# When set, the adversarial simulator also reads VAPI_LLM_SECRET and attaches
# a matching Bearer header — production-parity testing works automatically.
VAPI_LLM_SECRET=
VAPI_SERVER_SECRET=
